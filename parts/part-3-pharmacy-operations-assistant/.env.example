# Use one authentication path. Never commit the real value.
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted by the Google Gen AI client.

TELEGRAM_BOT_TOKEN=
# Assessment demo: true allows anyone to message the bot privately. Group chats stay blocked.
TELEGRAM_PUBLIC_ACCESS=false
# Used only when TELEGRAM_PUBLIC_ACCESS=false.
TELEGRAM_ALLOWED_USER_IDS=

GOOGLE_MODEL=gemini-3.5-flash-lite
OPERATIONS_DATA_PATH=data/operations_data_anonymized.xlsx
MIN_COMPARISON_ORDERS=50
MIN_COMPARISON_DAYS=14
MIN_COMPLETENESS=0.90
LONG_DELIVERY_MINUTES=90
